drop table if exists fts_perf_t1, fts_perf_t2;
# tokenize keeps its word order and word counts
select tokenize('数据库 数据库 全文索引 数据库 全文索引 分词', 'ik', '[{"output":"all"}]');
tokenize('数据库 数据库 全文索引 数据库 全文索引 分词', 'ik', '[{"output":"all"}]')
{"tokens": [{"分词": 1}, {"数据库": 3}, {"全文索引": 2}], "doc_len": 6}
select tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例', 'ik');
tokenize('OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例', 'ik')
["实例", "oceanbase", "解析器", "非常", "全文索引", "一款", "包括", "热", "复用", "分词器", "稳定", "优化", "用词", "的", "单", "全局", "数据库", "停", "路径", "例", "是"]
select tokenize('the quick quick quick brown fox fox jumps over the lazy dog', 'beng', '[{"output":"all"}]');
tokenize('the quick quick quick brown fox fox jumps over the lazy dog', 'beng', '[{"output":"all"}]')
{"tokens": [{"lazy": 1}, {"over": 1}, {"quick": 3}, {"dog": 1}, {"brown": 1}, {"fox": 2}, {"jumps": 1}], "doc_len": 10}
select tokenize('The THE tHe about Hello   world  ', 'beng');
tokenize('The THE tHe about Hello   world  ', 'beng')
["world", "hello"]
select tokenize('hello hello world the hello WORLD', 'space', '[{"output":"all"}]');
tokenize('hello hello world the hello WORLD', 'space', '[{"output":"all"}]')
{"tokens": [{"world": 2}, {"hello": 3}], "doc_len": 5}
select tokenize('一二三四五 六七八 拾佰仟 卅廿 3个 两件 1.2亿 110个', 'ik');
tokenize('一二三四五 六七八 拾佰仟 卅廿 3个 两件 1.2亿 110个', 'ik')
["六七八", "110个", "两件", "拾佰仟", "3个", "一二三四五", "1.2亿", "卅廿"]
select tokenize('say "hi" \\ back/slash 中文', 'space');
tokenize('say "hi" \\ back/slash 中文', 'space')
["say", "slash", "back"]
select tokenize('', 'ik');
tokenize('', 'ik')
[]
# JSON printing of arrays and objects
select json_array('a', '', '中文', 'q"uote', 1, 2.5, true, null, json_array('x', json_object('k', 'v')));
json_array('a', '', '中文', 'q"uote', 1, 2.5, true, null, json_array('x', json_object('k', 'v')))
["a", "", "中文", "q\"uote", 1, 2.5, true, null, ["x", {"k": "v"}]]
select json_object('s', 'str', 'e', '', 'n', 1, 'a', json_array('p', 'q'));
json_object('s', 'str', 'e', '', 'n', 1, 'a', json_array('p', 'q'))
{"a": ["p", "q"], "e": "", "n": 1, "s": "str"}
select json_pretty(json_array('a', json_object('k', 'v'), 1, null));
json_pretty(json_array('a', json_object('k', 'v'), 1, null))
[
  "a",
  {
    "k": "v"
  },
  1,
  null
]
create table fts_perf_t1 (
id bigint primary key,
title varchar(200),
content text,
title_en varchar(200),
content_en text,
key idx_title_en (title_en)
);
insert into fts_perf_t1 values
(1, '全文索引', '倒排索引 分词器 数据库', 'fulltext index', 'inverted index tokenizer database'),
(2, '数据库', 'OceanBase 稳定 数据库 性能', 'database', 'stable database performance'),
(3, '分词器', '全文索引 分词器 热路径', 'tokenizer', 'tokenizer hot path'),
(4, '查询', '倒排索引 查询 合并', 'query', 'inverted index query merge'),
(5, '构建', '索引 构建 排序 并行', 'build', 'index build sort parallel'),
(6, '稳定', 'OceanBase 稳定 database', 'stable', 'oceanbase stable database'),
(7, '审计', 'database performance audit 审计', 'audit', 'database performance audit'),
(8, '空', '无关 内容', 'none', 'nothing related'),
(9, '倒排', '倒排 索引 tokenizer', 'inverted', 'inverted tokenizer'),
(10, '全文', '全文索引 全文索引 分词器 分词器', 'fulltext', 'fulltext fulltext tokenizer');
insert into fts_perf_t1 select id + 10, title, content, title_en, content_en from fts_perf_t1;
insert into fts_perf_t1 select id + 20, title, content, title_en, content_en from fts_perf_t1;
# indexes built without any parallel setting (default degree)
alter table fts_perf_t1 add fulltext index ft_all(title, content) with parser ik;
alter table fts_perf_t1 add fulltext index ft_en(title_en, content_en) with parser beng;
# MATCH results, scores and filters
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器');
count(*)
12
select count(*) from fts_perf_t1 where match(title_en, content_en) against('database performance audit');
count(*)
16
select count(*) from fts_perf_t1 where match(title, content) against('OceanBase 稳定 database');
count(*)
12
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器') > 0;
count(*)
12
select count(*) from fts_perf_t1 where match(title, content) against('+全文索引 +分词器' in boolean mode);
count(*)
12
select sum(id), min(id), max(id) from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer');
sum(id)	min(id)	max(id)
316	1	39
select id from fts_perf_t1 where match(title, content) against('全文索引 分词器')
order by match(title, content) against('全文索引 分词器') desc, id limit 8;
id
10
20
30
40
3
13
23
33
select id from fts_perf_t1 where match(title_en, content_en) against('database performance audit')
order by match(title_en, content_en) against('database performance audit') desc, id limit 8;
id
7
