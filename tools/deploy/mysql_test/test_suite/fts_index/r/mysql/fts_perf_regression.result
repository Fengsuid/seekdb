# COUNT over a LIMIT derived table, and views whose columns are read
select count(*) from (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5) t;
count(*)
5
select count(*) from (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 1000) t;
count(*)
16
select count(*) from (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5 offset 2) t;
count(*)
5
select count(*) from ((select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 3) t1,
(select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 4) t2);
count(*)
12
select t.id from (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5) t order by t.id;
id
1
9
19
29
39
select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5;
id
39
9
29
19
1
select count(*), sum(id) from fts_perf_t1 where id in (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5);
count(*)	sum(id)
5	97
select count(*) from (select id from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer') limit 5) t
where exists (select 1 from fts_perf_t1 x where x.id = t.id);
count(*)
5
# index lookups with a small LIMIT
select id, title_en from fts_perf_t1 where title_en > 'b' order by title_en, id limit 3;
id	title_en
5	build
15	build
25	build
select id, title_en from fts_perf_t1 force index(idx_title_en) where title_en >= 'fulltext' limit 2;
id	title_en
10	fulltext
20	fulltext
select id from fts_perf_t1 where match(title, content) against('倒排索引') order by id limit 3;
id
1
4
5
# explicit parallel builds give the same results as the default build
alter table fts_perf_t1 drop index ft_all;
alter /*+ parallel(12) */ table fts_perf_t1 add fulltext index ft_all(title, content) with parser ik;
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器');
count(*)
12
select sum(id), min(id), max(id) from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer');
sum(id)	min(id)	max(id)
316	1	39
select id from fts_perf_t1 where match(title, content) against('全文索引 分词器')
order by match(title, content) against('全文索引 分词器') desc, id limit 8;
id
10
20
30
40
3
13
23
33
alter table fts_perf_t1 drop index ft_all;
alter /*+ parallel(1) */ table fts_perf_t1 add fulltext index ft_all(title, content) with parser ik;
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器');
count(*)
12
select sum(id), min(id), max(id) from fts_perf_t1 where match(title, content) against('倒排索引 tokenizer');
sum(id)	min(id)	max(id)
316	1	39
# rows inserted after the index build are visible to MATCH
insert into fts_perf_t1 values (100, '新增', '全文索引 分词器 新增', 'new', 'new database audit');
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器');
count(*)
13
select count(*) from fts_perf_t1 where match(title_en, content_en) against('database performance audit');
count(*)
17
delete from fts_perf_t1 where id = 100;
select count(*) from fts_perf_t1 where match(title, content) against('全文索引 分词器');
count(*)
12
drop table fts_perf_t1;
